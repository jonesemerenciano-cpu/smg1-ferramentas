// ── DB ──
function loadDB(){try{const r=localStorage.getItem(STORAGE_KEY);if(r)return JSON.parse(r);}catch(e){}return{novatos:[],inativos:[],pwd:DEFAULT_PWD};}
function saveDB(){localStorage.setItem(STORAGE_KEY,JSON.stringify(DB));}
let DB=loadDB();
if(!DB.pwd) DB.pwd=DEFAULT_PWD;

// ── HELPERS ──
function getAtivos(g){
  const fixos=BASE_FIXA[g].filter(m=>!DB.inativos.some(i=>i.nome===m.n&&i.grupo===g)).map(m=>({...m,fixo:true}));
  const novs=DB.novatos.filter(n=>n.grupo===g&&n.ativo).map(n=>({n:n.nome,g:n.genero,r:n.rota,e:n.empresa,fixo:false,id:n.id}));
  return[...fixos,...novs];
}
function todos(){return GROUPS.flatMap(g=>getAtivos(g).map(m=>({...m,grupo:g})));}
function countG(g,gen){return getAtivos(g).filter(m=>m.g===gen).length;}

