function renderVisao(){
  const q = normalizar(document.getElementById('visao-search').value.trim());

  // Stats globais
  let tot=0,f=0,m=0,nov=0;
  GROUPS.forEach(g=>{const a=getAtivos(g);tot+=a.length;f+=a.filter(x=>x.g==='F').length;m+=a.filter(x=>x.g==='M').length;nov+=DB.novatos.filter(n=>n.grupo===g&&n.ativo).length;});
  document.getElementById('visao-stats').innerHTML=`
    <div class="vg-stat"><div class="vs-val" style="color:var(--yellow);">${tot}</div><div class="vs-lbl">Ativos</div></div>
    <div class="vg-stat"><div class="vs-val" style="color:var(--fem);">${f}</div><div class="vs-lbl">Feminino</div></div>
    <div class="vg-stat"><div class="vs-val" style="color:var(--masc);">${m}</div><div class="vs-lbl">Masculino</div></div>
    <div class="vg-stat"><div class="vs-val" style="color:var(--green);">${nov}</div><div class="vs-lbl">Novatos</div></div>
    ${GROUPS.map(g=>{
      const a=getAtivos(g),fC=a.filter(x=>x.g==='F').length,mC=a.filter(x=>x.g==='M').length,cor=GROUP_COLORS[g];
      return`<div class="vg-stat" style="border-color:${cor}33;">
        <div class="vs-val" style="color:${cor};">GRP ${g}</div>
        <div class="vs-lbl" style="margin-top:4px;"><span style="color:var(--fem);">${fC}F</span> · <span style="color:var(--masc);">${mC}M</span> · <span style="color:var(--text);">${a.length}</span></div>
      </div>`;
    }).join('')}`;

  // Cards dos grupos
  const grid = document.getElementById('visao-grid');
  grid.innerHTML='';
  GROUPS.forEach(key=>{
    const members = getAtivos(key).sort((a,b)=>a.n.localeCompare(b.n));
    const fC=members.filter(m=>m.g==='F').length, mC=members.filter(m=>m.g==='M').length;
    const tot=members.length, fPct=tot>0?Math.round(fC/tot*100):0;
    const cor=GROUP_COLORS[key];
    const novCount=members.filter(m=>!m.fixo).length;

    const card=document.createElement('div');
    card.className='vg-card';
    card.style.borderColor=cor+'44';

    const rowsHtml = members.map((m,i)=>{
      const matched = q && normalizar(m.n).includes(q);
      const dimmed  = q && !matched;
      return`<div class="vg-row ${matched?'highlight':''} ${dimmed?'dimmed':''}">
        <span class="vg-num">${String(i+1).padStart(2,'0')}</span>
        <span class="vg-tag vg-tag-${m.g}">${m.g}</span>
        <span class="vg-name">${q && matched ? highlight(m.n, q) : m.n}</span>
        <span class="vg-rota">${m.r}</span>
        <span class="vg-badge ${m.fixo?'badge-fixo':'badge-novo'}">${m.fixo?'●':'★'}</span>
      </div>`;
    }).join('');

    card.innerHTML=`
      <div class="vg-head" style="background:${cor}0a;">
        <div style="display:flex;align-items:center;gap:10px;">
          <div class="vg-letter" style="color:${cor};">${key}</div>
          <div>
            <div style="font-size:13px;font-weight:700;">Grupo ${key}</div>
            <div style="font-size:10px;color:var(--muted2);margin-top:1px;">${novCount>0?`${novCount} novato${novCount>1?'s':''}`:''}</div>
          </div>
        </div>
        <div class="vg-info">
          <div class="vg-total" style="color:${cor};">${tot}</div>
          <div class="vg-comp"><span style="color:var(--fem);">${fC}F</span> · <span style="color:var(--masc);">${mC}M</span></div>
        </div>
      </div>
      <div class="vg-bar-row">
        <span style="font-size:9px;color:var(--fem);">${fPct}%F</span>
        <div class="vg-bar-track">
          <div class="bar-f" style="width:${fPct}%"></div>
          <div class="bar-m" style="width:${100-fPct}%"></div>
        </div>
        <span style="font-size:9px;color:var(--masc);">${100-fPct}%M</span>
      </div>
      <div class="vg-members">${rowsHtml||'<div class="empty">Vazio.</div>'}</div>
      <div class="vg-foot">
        <span class="vg-foot-stat">Fixos: <span>${members.filter(m=>m.fixo).length}</span></span>
        <span class="vg-foot-stat">Novatos: <span style="color:var(--green);">${novCount}</span></span>
        <span class="vg-foot-stat">Total: <span style="color:${cor};">${tot}</span></span>
      </div>`;
    grid.appendChild(card);
  });
}

// ══ LOGIN ════════════════════════════════════
function tentarLogin(){
  const pwd=document.getElementById('login-pwd').value;
  if(pwd===DB.pwd){showScreen('screen-admin');renderAll();}
  else{const err=document.getElementById('login-err');err.style.display='block';setTimeout(()=>err.style.display='none',3000);}
}

function alterarSenha(){
  const atual=document.getElementById('pwd-atual').value;
  const nova=document.getElementById('pwd-nova').value;
  const conf=document.getElementById('pwd-confirmar').value;
  if(atual!==DB.pwd){toast('⚠️','Senha atual incorreta.');return;}
  if(nova.length<4){toast('⚠️','Nova senha precisa ter pelo menos 4 caracteres.');return;}
  if(nova!==conf){toast('⚠️','As senhas não coincidem.');return;}
  DB.pwd=nova;saveDB();
  document.getElementById('pwd-atual').value='';
  document.getElementById('pwd-nova').value='';
  document.getElementById('pwd-confirmar').value='';
  toast('✅','Senha alterada com sucesso!');
}

// ══ VISÃO COLABORADOR ════════════════════════
let acSelected=-1;
function normalizar(s){return s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase();}

function onColabInput(){
  const val=document.getElementById('colab-input').value.trim();
  const acList=document.getElementById('ac-list');
  document.getElementById('colab-result').innerHTML='';
  acSelected=-1;
  if(val.length<3){acList.classList.remove('show');acList.innerHTML='';return;}
  const q=normalizar(val);
  const matches=todos().filter(m=>normalizar(m.n).includes(q)).slice(0,8);
  if(!matches.length){acList.classList.remove('show');acList.innerHTML='';return;}
  acList.innerHTML=matches.map((m,i)=>`<div class="ac-item" data-idx="${i}" onclick="selecionarColaborador('${m.n.replace(/'/g,"\\'")}','${m.grupo}')">${highlight(m.n,q)} <span style="color:var(--muted);font-size:11px;">— Grupo ${m.grupo}</span></div>`).join('');
  acList.classList.add('show');
}

function highlight(nome,q){return nome.replace(new RegExp(q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'i'),s=>`<mark>${s}</mark>`);}

function onColabKey(e){
  const items=document.querySelectorAll('.ac-item');
  if(e.key==='ArrowDown'){acSelected=Math.min(acSelected+1,items.length-1);items.forEach((el,i)=>el.style.background=i===acSelected?'rgba(255,230,0,0.07)':'');}
  else if(e.key==='ArrowUp'){acSelected=Math.max(acSelected-1,0);items.forEach((el,i)=>el.style.background=i===acSelected?'rgba(255,230,0,0.07)':'');}
  else if(e.key==='Enter'&&acSelected>=0){items[acSelected].click();}
  else if(e.key==='Escape'){document.getElementById('ac-list').classList.remove('show');}
}

function selecionarColaborador(nome,grupo){
  document.getElementById('colab-input').value=nome;
  document.getElementById('ac-list').classList.remove('show');
  const col=getAtivos(grupo).find(m=>m.n===nome);
  if(!col){document.getElementById('colab-result').innerHTML=`<div class="colab-not-found"><div class="nf-icon">🔍</div><p>Colaborador não encontrado nos grupos ativos.</p></div>`;return;}
  const cor=GROUP_COLORS[grupo];
  const colegas=getAtivos(grupo).sort((a,b)=>a.n.localeCompare(b.n));
  const fC=colegas.filter(x=>x.g==='F').length, mC=colegas.filter(x=>x.g==='M').length;
  document.getElementById('colab-result').innerHTML=`
    <div class="colab-card">
      <div class="colab-card-banner" style="background:linear-gradient(135deg,${cor}18,${cor}06);">
        <div class="group-big-letter" style="color:${cor};">${grupo}</div>
        <div class="group-label" style="color:${cor};">Grupo ${grupo}</div>
      </div>
      <div class="colab-name">
        <div class="cn-label">Você está aqui</div>
        <div class="cn-nome">👤 ${nome}</div>
      </div>
      <div class="colab-meta">
        <div class="meta-item"><div class="mi-lbl">Rota</div><div class="mi-val">${col.r}</div></div>
        <div class="meta-item"><div class="mi-lbl">Empresa</div><div class="mi-val">${col.e}</div></div>
        <div class="meta-item"><div class="mi-lbl">Total no grupo</div><div class="mi-val">${colegas.length} REPs</div></div>
        <div class="meta-item"><div class="mi-lbl">Composição</div><div class="mi-val"><span style="color:var(--fem);">${fC}F</span> · <span style="color:var(--masc);">${mC}M</span></div></div>
      </div>
      <div class="colab-colegas">
        <div class="cc-title">Todos do Grupo ${grupo}</div>
        <div class="colega-list">
          ${colegas.map(c=>`
          <div class="colega-row ${c.n===nome?'destaque':''}">
            <span class="cr-tag cr-${c.g}">${c.g}</span>
            <span class="cr-nome">${c.n}</span>
            ${c.n===nome?'<span class="cr-voce">← você</span>':''}
          </div>`).join('')}
        </div>
      </div>
    </div>`;
}

// ══ ADMIN: STATS ═════════════════════════════
function renderStats(){
  let tot=0,f=0,m=0,nov=0;
  GROUPS.forEach(g=>{const a=getAtivos(g);tot+=a.length;f+=a.filter(x=>x.g==='F').length;m+=a.filter(x=>x.g==='M').length;nov+=DB.novatos.filter(n=>n.grupo===g&&n.ativo).length;});
  const inat=DB.inativos.length+DB.novatos.filter(n=>!n.ativo).length;
  document.getElementById('stat-row').innerHTML=`
    <div class="stat-box"><div class="val val-y">${tot}</div><div class="lbl">Total Ativos</div></div>
    <div class="stat-box"><div class="val val-f">${f}</div><div class="lbl">Feminino</div></div>
    <div class="stat-box"><div class="val val-m">${m}</div><div class="lbl">Masculino</div></div>
    <div class="stat-box"><div class="val val-g">${nov}</div><div class="lbl">Novatos</div></div>
    <div class="stat-box"><div class="val val-r">${inat}</div><div class="lbl">Inativos</div></div>
    ${GROUPS.map(g=>{const a=getAtivos(g),fC=a.filter(x=>x.g==='F').length,mC=a.filter(x=>x.g==='M').length;return`<div class="stat-box" style="border-color:${GROUP_COLORS[g]}33;"><div class="val" style="color:${GROUP_COLORS[g]};font-size:16px;">GRP ${g} <span style="font-size:20px;">${a.length}</span></div><div class="lbl" style="margin-top:4px;"><span style="color:var(--fem);">${fC}F</span> · <span style="color:var(--masc);">${mC}M</span></div></div>`;}).join('')}`;
  const badge=document.getElementById('inativo-badge');
  badge.style.display=inat>0?'inline':'none';if(inat>0)badge.textContent=inat;
}

// ══ ADMIN: GRUPOS ════════════════════════════
function renderGroups(){
  const grid=document.getElementById('groups-grid');grid.innerHTML='';
  GROUPS.forEach(key=>{
    const members=getAtivos(key).sort((a,b)=>a.n.localeCompare(b.n));
    const fC=members.filter(m=>m.g==='F').length,mC=members.filter(m=>m.g==='M').length;
    const tot=members.length,fPct=tot>0?Math.round(fC/tot*100):0;
    const cor=GROUP_COLORS[key];
    const card=document.createElement('div');card.className='gcard';
    card.innerHTML=`
      <div class="gcard-head" style="border-bottom-color:${cor}22;">
        <div style="display:flex;align-items:center;">
          <div class="gletter" style="color:${cor};">${key}</div>
          <div class="gname">GRUPO ${key}</div>
        </div>
        <div class="gcount">${tot} REPs</div>
      </div>
      <div class="gbar-row">
        <div class="bar-track"><div class="bar-f" style="width:${fPct}%"></div><div class="bar-m" style="width:${100-fPct}%"></div></div>
        <div class="gleg"><span><span class="dot dot-f"></span>${fC}F</span><span><span class="dot dot-m"></span>${mC}M</span></div>
      </div>
      <div class="glist">
        ${members.length===0?'<div class="empty">Grupo vazio.</div>':
          members.map((m,i)=>`<div class="grow">
            <span class="grow-num">${String(i+1).padStart(2,'0')}</span>
            <span class="gtag gtag-${m.g}">${m.g}</span>
            <span class="grow-name">${m.n}</span>
            <span class="grow-rota">${m.r}</span>
            <span class="grow-badge ${m.fixo?'badge-fixo':'badge-novo'}">${m.fixo?'●':'★'}</span>
            <button class="inativo-btn" title="Inativar" onclick="inativar('${m.n.replace(/'/g,"\\'").replace(/"/g,'\\"')}','${key}',${m.fixo},${m.fixo?'null':`'${m.id}'`})">✕</button>
          </div>`).join('')}
      </div>`;
    grid.appendChild(card);
  });
}

// ══ ADMIN: INATIVOS ══════════════════════════
function renderInativos(){
  const list=document.getElementById('inativo-list');
  const todos=[
    ...DB.inativos.map(i=>({...i,tipo:'fixo'})),
    ...DB.novatos.filter(n=>!n.ativo).map(n=>({nome:n.nome,grupo:n.grupo,genero:n.genero,id:n.id,tipo:'novato'}))
  ].sort((a,b)=>a.nome.localeCompare(b.nome));
  if(!todos.length){list.innerHTML='<div class="empty">Nenhum colaborador inativo.</div>';return;}
  list.innerHTML=todos.map(i=>`<div class="inativo-row">
    <span class="gtag gtag-${i.genero}">${i.genero}</span>
    <span class="inativo-nome">${i.nome}</span>
    <span style="font-size:10px;color:var(--muted);margin-right:4px;">GRP ${i.grupo}</span>
    <span class="grow-badge ${i.tipo==='fixo'?'badge-fixo':'badge-novo'}" style="margin-right:8px;">${i.tipo==='fixo'?'●':'★'}</span>
    <button class="reativar-btn" onclick="reativar('${i.nome.replace(/'/g,"\\'").replace(/"/g,'\\"')}','${i.grupo}','${i.tipo}',${i.tipo==='novato'?`'${i.id}'`:'null'})">Reativar</button>
  </div>`).join('');
}

// ══ AÇÕES ADMIN ══════════════════════════════
function inativar(nome,grupo,fixo,id){
  if(!confirm(`Inativar "${nome}" do Grupo ${grupo}?`))return;
  if(fixo){const gen=BASE_FIXA[grupo].find(m=>m.n===nome)?.g||'?';DB.inativos.push({nome,grupo,genero:gen});}
  else{const n=DB.novatos.find(x=>x.id===id);if(n)n.ativo=false;}
  saveDB();renderAll();toast('✅',`${nome} inativado.`);
}

function reativar(nome,grupo,tipo,id){
  if(tipo==='fixo'){DB.inativos=DB.inativos.filter(i=>!(i.nome===nome&&i.grupo===grupo));}
  else{const n=DB.novatos.find(x=>x.id===id);if(n)n.ativo=true;}
  saveDB();renderAll();toast('🟢',`${nome} reativado no Grupo ${grupo}.`);
}

function limparInativosNovatos(){
  const c=DB.novatos.filter(n=>!n.ativo).length;
  if(!c){toast('ℹ️','Nenhum novato inativo.');return;}
  if(!confirm(`Remover ${c} novato(s) inativo(s) permanentemente?`))return;
  DB.novatos=DB.novatos.filter(n=>n.ativo);saveDB();renderAll();toast('🗑️',`${c} removido(s).`);
}

// ══ SUGESTÃO ═════════════════════════════════
function sugerirGrupo(){
  const nome=document.getElementById('inp-nome').value.trim();
  const gen=document.getElementById('inp-genero').value;
  const rota=document.getElementById('inp-rota').value.trim();
  if(!nome){toast('⚠️','Digite o nome.');return;}
  if(!gen){toast('⚠️','Selecione o gênero.');return;}
  if(todos().some(m=>normalizar(m.n)===normalizar(nome))){toast('⚠️','Colaborador já está em um grupo ativo.');return;}
  const counts=GROUPS.map(g=>({g,c:countG(g,gen),t:getAtivos(g).length}));
  const minC=Math.min(...counts.map(x=>x.c));
  const rec=counts.filter(x=>x.c===minC).sort((a,b)=>a.t-b.t)[0].g;
  document.getElementById('suggestion-box').classList.add('show');
  document.getElementById('sugg-options').innerHTML=GROUPS.map(g=>{
    const c=counts.find(x=>x.g===g),isRec=g===rec;
    return`<div class="sugg-chip ${isRec?'recommended':''}" onclick="adicionarNoGrupo('${g}','${nome}','${gen}','${rota}')">
      <div class="sc-letter" style="color:${isRec?'var(--green)':GROUP_COLORS[g]};">${g}</div>
      <div class="sc-info">${c.c}${gen} · ${c.t} total</div>
      ${isRec?'<div class="sc-rec">✓ Recomendado</div>':''}
    </div>`;
  }).join('');
}

function adicionarNoGrupo(grupo,nome,genero,rota){
  const empresa=document.getElementById('inp-empresa').value;
  const id='nov_'+Date.now()+'_'+Math.random().toString(36).slice(2,6);
  DB.novatos.push({id,nome,genero,rota:rota||'—',empresa,grupo,ativo:true,entrada:new Date().toLocaleDateString('pt-BR')});
  saveDB();
  document.getElementById('inp-nome').value='';
  document.getElementById('inp-genero').value='';
  document.getElementById('inp-rota').value='';
  document.getElementById('suggestion-box').classList.remove('show');
  renderAll();showAdminTab('grupos');toast('✅',`${nome} → Grupo ${grupo}!`);
}

// ══ EXPORT ═══════════════════════════════════
function exportarTexto(){
  let txt=`GRUPOS DE TRABALHO — SMG1 T2\n${new Date().toLocaleString('pt-BR')}\n${'─'.repeat(50)}\n\n`;
  GROUPS.forEach(g=>{
    const m=getAtivos(g).sort((a,b)=>a.n.localeCompare(b.n));
    const fC=m.filter(x=>x.g==='F').length,mC=m.filter(x=>x.g==='M').length;
    txt+=`GRUPO ${g}  |  ${m.length} REPs  (${fC}F / ${mC}M)\n`;
    m.forEach((r,i)=>txt+=`  ${String(i+1).padStart(2,'0')}. [${r.g}] ${r.n}  —  Rota ${r.r}  ${r.fixo?'[FIXO]':'[NOVATO]'}\n`);
    txt+='\n';
  });
  navigator.clipboard.writeText(txt).then(()=>toast('📋','Copiado para a área de transferência!'));
}

// ══ TABS ADMIN ═══════════════════════════════
function showAdminTab(tab){
  ['grupos','adicionar','inativos','senha'].forEach(t=>document.getElementById('atab-'+t).style.display='none');
  document.querySelectorAll('.atab').forEach(el=>el.classList.remove('active'));
  document.getElementById('atab-'+tab).style.display='block';
  const idx={grupos:0,adicionar:1,inativos:2,senha:3};
  document.querySelectorAll('.atab')[idx[tab]].classList.add('active');
  if(tab==='inativos')renderInativos();
}

// ══ TOAST ════════════════════════════════════
let toastTmr;
function toast(icon,msg){
  const el=document.getElementById('toast');
  document.getElementById('toast-icon').textContent=icon;
  document.getElementById('toast-msg').textContent=msg;
  el.classList.add('show');clearTimeout(toastTmr);
  toastTmr=setTimeout(()=>el.classList.remove('show'),3000);
}

function renderAll(){renderStats();renderGroups();renderInativos();}

// INIT
showScreen('screen-select');
</script>
