<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Grupos de Trabalho — SMG1 T2</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');
:root {
  --yellow:#FFE600; --dark:#141414; --mid:#1E1E1E; --card:#242424; --card2:#2A2A2A;
  --border:#333; --border2:#444; --text:#E8E8E8; --muted:#777; --muted2:#999;
  --fem:#FF6B9D; --masc:#4DA6FF; --fem-bg:rgba(255,107,157,0.12); --masc-bg:rgba(77,166,255,0.12);
  --green:#3ECF8E; --red:#FF5252; --green-bg:rgba(62,207,142,0.1); --red-bg:rgba(255,82,82,0.1);
  --A:#FFE600; --B:#3ECF8E; --C:#4DA6FF; --D:#FF6B9D;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{background:var(--dark);color:var(--text);font-family:'Inter',sans-serif;font-size:13px;min-height:100vh;display:flex;flex-direction:column;}

/* ── SCREENS ── */
.screen{display:none;flex:1;}
.screen.active{display:flex;flex-direction:column;flex:1;}

/* ══════════════════════════════════════════
   TELA DE SELEÇÃO DE MODO
══════════════════════════════════════════ */
#screen-select{align-items:center;justify-content:center;min-height:100vh;}
.select-wrap{text-align:center;padding:40px 24px;}
.select-logo{background:var(--yellow);color:var(--dark);font-family:'JetBrains Mono',monospace;font-weight:700;font-size:12px;padding:5px 14px;border-radius:5px;letter-spacing:.06em;display:inline-block;margin-bottom:24px;}
.select-title{font-size:26px;font-weight:800;margin-bottom:6px;}
.select-sub{font-size:13px;color:var(--muted2);margin-bottom:40px;}
.mode-cards{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;}
.mode-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:32px 28px;width:240px;cursor:pointer;transition:all .2s;text-align:center;}
.mode-card:hover{border-color:var(--yellow);transform:translateY(-3px);box-shadow:0 12px 40px rgba(0,0,0,.4);}
.mode-card .mc-icon{font-size:40px;margin-bottom:14px;}
.mode-card .mc-title{font-size:15px;font-weight:700;margin-bottom:6px;}
.mode-card .mc-desc{font-size:11px;color:var(--muted2);line-height:1.6;}
.mode-card.admin-card:hover{border-color:var(--red);}
.mode-card.visao-card:hover{border-color:#4DA6FF;}

/* ══════════════════════════════════════════
   VISÃO COLABORADOR
══════════════════════════════════════════ */
.colab-topbar{background:var(--mid);border-bottom:2px solid var(--yellow);padding:0 24px;display:flex;align-items:center;height:52px;gap:12px;}
.colab-logo{background:var(--yellow);color:var(--dark);font-family:'JetBrains Mono',monospace;font-weight:700;font-size:11px;padding:3px 10px;border-radius:4px;}
.colab-title{font-size:14px;font-weight:600;}
.back-btn{margin-left:auto;background:none;border:1px solid var(--border2);color:var(--muted2);border-radius:7px;padding:5px 14px;font-size:11px;cursor:pointer;font-family:'Inter',sans-serif;transition:all .15s;}
.back-btn:hover{border-color:var(--text);color:var(--text);}

.colab-body{flex:1;display:flex;flex-direction:column;align-items:center;padding:40px 24px;}
.search-box{width:100%;max-width:500px;margin-bottom:32px;}
.search-box label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:8px;}
.search-input-wrap{position:relative;}
.search-input{width:100%;background:var(--card);border:2px solid var(--border2);color:var(--text);border-radius:12px;padding:14px 18px 14px 46px;font-size:15px;font-family:'Inter',sans-serif;outline:none;transition:border .2s;}
.search-input:focus{border-color:var(--yellow);}
.search-icon{position:absolute;left:16px;top:50%;transform:translateY(-50%);font-size:18px;color:var(--muted);}
.search-hint{font-size:11px;color:var(--muted);margin-top:8px;text-align:center;}

/* Resultado colaborador */
.colab-result{width:100%;max-width:500px;}
.colab-not-found{text-align:center;padding:40px;color:var(--muted2);}
.colab-not-found .nf-icon{font-size:48px;margin-bottom:12px;}
.colab-not-found p{font-size:13px;}

.colab-card{background:var(--card);border:2px solid var(--border);border-radius:20px;overflow:hidden;animation:fadeUp .3s ease;}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}
.colab-card-banner{padding:28px 28px 24px;text-align:center;position:relative;}
.colab-card-banner::after{content:'';position:absolute;inset:0;opacity:.05;pointer-events:none;}
.group-big-letter{font-family:'JetBrains Mono',monospace;font-size:80px;font-weight:700;line-height:1;margin-bottom:4px;}
.group-label{font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;opacity:.7;}
.colab-name{background:var(--card2);padding:18px 28px;border-top:1px solid var(--border);}
.colab-name .cn-label{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:4px;}
.colab-name .cn-nome{font-size:15px;font-weight:600;}
.colab-meta{padding:14px 28px;border-top:1px solid var(--border);display:flex;gap:20px;flex-wrap:wrap;}
.meta-item{display:flex;flex-direction:column;gap:2px;}
.meta-item .mi-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);}
.meta-item .mi-val{font-size:12px;font-weight:600;}
.colab-colegas{padding:16px 28px;border-top:1px solid var(--border);}
.colab-colegas .cc-title{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin-bottom:10px;}
.colega-list{display:flex;flex-direction:column;gap:4px;max-height:200px;overflow-y:auto;}
.colega-row{display:flex;align-items:center;gap:8px;padding:5px 8px;border-radius:6px;}
.colega-row.destaque{background:rgba(255,230,0,0.08);border:1px solid rgba(255,230,0,0.2);}
.colega-row .cr-tag{font-size:9px;font-weight:700;border-radius:3px;padding:1px 5px;}
.cr-F{background:var(--fem-bg);color:var(--fem);}
.cr-M{background:var(--masc-bg);color:var(--masc);}
.colega-row .cr-nome{font-size:11px;flex:1;}
.colega-row .cr-voce{font-size:9px;color:var(--yellow);font-weight:600;}

/* Autocomplete */
.autocomplete-list{background:var(--card2);border:1px solid var(--border2);border-radius:10px;margin-top:6px;overflow:hidden;display:none;}
.autocomplete-list.show{display:block;}
.ac-item{padding:10px 16px;cursor:pointer;font-size:13px;border-bottom:1px solid var(--border);transition:background .1s;}
.ac-item:last-child{border-bottom:none;}
.ac-item:hover{background:rgba(255,230,0,0.07);}
.ac-item mark{background:none;color:var(--yellow);font-weight:600;}

/* ══════════════════════════════════════════
   LOGIN ADMIN
══════════════════════════════════════════ */
#screen-login{align-items:center;justify-content:center;min-height:100vh;}
.login-box{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:36px;width:340px;text-align:center;}
.login-icon{font-size:36px;margin-bottom:12px;}
.login-title{font-size:16px;font-weight:700;margin-bottom:4px;}
.login-sub{font-size:12px;color:var(--muted2);margin-bottom:24px;}
.login-field{text-align:left;margin-bottom:14px;}
.login-field label{font-size:10px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);display:block;margin-bottom:5px;}
.login-field input{width:100%;background:var(--mid);border:1px solid var(--border2);color:var(--text);border-radius:8px;padding:10px 14px;font-size:13px;font-family:'Inter',sans-serif;outline:none;transition:border .15s;}
.login-field input:focus{border-color:var(--yellow);}
.login-err{font-size:11px;color:var(--red);margin-bottom:10px;display:none;}
.login-back{margin-top:14px;font-size:11px;color:var(--muted2);cursor:pointer;}
.login-back:hover{color:var(--text);}

/* ══════════════════════════════════════════
   ADMIN PANEL
══════════════════════════════════════════ */
.admin-topbar{background:var(--mid);border-bottom:2px solid var(--red);padding:0 28px;display:flex;align-items:center;height:52px;gap:14px;}
.admin-badge{background:var(--red);color:#fff;font-family:'JetBrains Mono',monospace;font-weight:700;font-size:11px;padding:3px 10px;border-radius:4px;}
.admin-title{font-size:14px;font-weight:600;}
.admin-tabs{background:var(--mid);border-bottom:1px solid var(--border);display:flex;padding:0 28px;gap:2px;}
.atab{padding:10px 16px;font-size:12px;font-weight:500;color:var(--muted2);cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;white-space:nowrap;}
.atab:hover{color:var(--text);}
.atab.active{color:var(--red);border-bottom-color:var(--red);font-weight:600;}
.admin-content{padding:24px 28px;}

/* Stats */
.stat-row{display:flex;gap:12px;margin-bottom:20px;flex-wrap:wrap;}
.stat-box{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 18px;min-width:90px;}
.stat-box .val{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;line-height:1;}
.stat-box .lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-top:3px;}
.val-y{color:var(--yellow);}.val-f{color:var(--fem);}.val-m{color:var(--masc);}.val-g{color:var(--green);}.val-r{color:var(--red);}

/* Groups grid */
.groups-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px;}
.gcard{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;}
.gcard-head{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.gletter{font-family:'JetBrains Mono',monospace;font-size:26px;font-weight:700;line-height:1;}
.gname{font-weight:600;margin-left:10px;font-size:13px;}
.gcount{font-family:'JetBrains Mono',monospace;font-size:11px;background:var(--mid);color:var(--muted2);padding:3px 10px;border-radius:20px;}
.gbar-row{padding:8px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;}
.bar-track{flex:1;height:5px;background:var(--border2);border-radius:3px;overflow:hidden;display:flex;}
.bar-f{background:var(--fem);}.bar-m{background:var(--masc);}
.gleg{display:flex;gap:10px;font-size:10px;}
.gleg span{display:flex;align-items:center;gap:3px;}
.dot{width:6px;height:6px;border-radius:50%;}.dot-f{background:var(--fem);}.dot-m{background:var(--masc);}
.glist{max-height:290px;overflow-y:auto;}
.glist::-webkit-scrollbar{width:3px;}.glist::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.grow{display:flex;align-items:center;padding:6px 14px;gap:8px;border-bottom:1px solid rgba(255,255,255,0.03);transition:background .1s;}
.grow:hover{background:rgba(255,255,255,0.04);}
.grow:last-child{border-bottom:none;}
.grow-num{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--muted);min-width:18px;}
.gtag{font-size:9px;font-weight:700;border-radius:3px;padding:1px 5px;}
.gtag-F{background:var(--fem-bg);color:var(--fem);}.gtag-M{background:var(--masc-bg);color:var(--masc);}
.grow-name{font-size:11.5px;flex:1;}
.grow-rota{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--muted);background:var(--mid);border-radius:3px;padding:1px 5px;}
.grow-badge{font-size:9px;padding:1px 6px;border-radius:3px;}
.badge-fixo{background:rgba(255,230,0,0.1);color:var(--yellow);}
.badge-novo{background:var(--green-bg);color:var(--green);}
.inativo-btn{background:none;border:none;color:var(--muted);cursor:pointer;font-size:13px;padding:2px 4px;border-radius:4px;transition:all .15s;line-height:1;}
.inativo-btn:hover{background:var(--red-bg);color:var(--red);}

/* Form */
.form-section{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px;}
.form-section h3{font-size:13px;font-weight:600;margin-bottom:14px;}
.form-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
.form-field{display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px;}
.form-field label{font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.06em;}
.form-field input,.form-field select{background:var(--mid);border:1px solid var(--border2);color:var(--text);border-radius:7px;padding:8px 12px;font-size:12px;font-family:'Inter',sans-serif;outline:none;transition:border .15s;}
.form-field input:focus,.form-field select:focus{border-color:var(--yellow);}
.form-field select option{background:var(--mid);}
.btn{padding:8px 18px;border-radius:7px;font-size:12px;font-weight:600;cursor:pointer;border:none;font-family:'Inter',sans-serif;transition:all .15s;}
.btn:hover{opacity:.85;}
.btn-y{background:var(--yellow);color:var(--dark);}
.btn-outline{background:transparent;border:1px solid var(--border2);color:var(--text);}
.btn-red{background:var(--red-bg);color:var(--red);border:1px solid rgba(255,82,82,0.4);}
.btn-sm{padding:5px 12px;font-size:11px;}
.suggestion-box{background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:14px 16px;display:none;margin-top:12px;}
.suggestion-box.show{display:block;}
.sugg-title{font-size:11px;color:var(--muted2);margin-bottom:10px;}
.sugg-options{display:flex;gap:10px;flex-wrap:wrap;}
.sugg-chip{background:var(--mid);border:1px solid var(--border2);border-radius:10px;padding:10px 16px;cursor:pointer;transition:all .15s;text-align:center;min-width:90px;}
.sugg-chip:hover{border-color:var(--yellow);background:rgba(255,230,0,.07);}
.sugg-chip .sc-letter{font-family:'JetBrains Mono',monospace;font-size:20px;font-weight:700;color:var(--yellow);}
.sugg-chip .sc-info{font-size:10px;color:var(--muted2);margin-top:3px;}
.sugg-chip .sc-rec{font-size:9px;color:var(--green);margin-top:4px;}
.sugg-chip.recommended{border-color:rgba(62,207,142,0.5);background:rgba(62,207,142,0.05);}
.sugg-chip.recommended .sc-letter{color:var(--green);}
.inativo-row{display:flex;align-items:center;padding:7px 14px;gap:8px;border-bottom:1px solid rgba(255,255,255,0.03);}
.inativo-row:last-child{border-bottom:none;}
.inativo-nome{flex:1;font-size:11.5px;color:var(--muted2);text-decoration:line-through;}
.reativar-btn{background:none;border:1px solid var(--border2);color:var(--muted2);cursor:pointer;font-size:10px;padding:2px 8px;border-radius:4px;font-family:'Inter',sans-serif;transition:all .15s;}
.reativar-btn:hover{border-color:var(--green);color:var(--green);}
.info-box{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:14px 18px;font-size:12px;color:var(--muted2);line-height:1.7;}
.info-box strong{color:var(--text);}

/* Toast */
.toast{position:fixed;bottom:24px;right:24px;background:var(--card2);border:1px solid var(--border2);border-radius:10px;padding:12px 18px;font-size:12px;font-weight:500;box-shadow:0 8px 32px rgba(0,0,0,.5);transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.16,1,.3,1);z-index:9999;display:flex;align-items:center;gap:10px;max-width:320px;}
.toast.show{transform:translateY(0);opacity:1;}
.empty{padding:24px;text-align:center;color:var(--muted);font-size:12px;}
::-webkit-scrollbar{width:5px;height:5px;}::-webkit-scrollbar-track{background:transparent;}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px;}

/* ── VISÃO GERAL ── */
.vg-stat{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 16px;min-width:80px;text-align:center;}
.vg-stat .vs-val{font-family:'JetBrains Mono',monospace;font-size:20px;font-weight:700;line-height:1;}
.vg-stat .vs-lbl{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;}
.vg-card{background:var(--card);border:2px solid var(--border);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;}
.vg-head{padding:14px 18px 10px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
.vg-letter{font-family:'JetBrains Mono',monospace;font-size:30px;font-weight:800;line-height:1;}
.vg-info{text-align:right;}
.vg-total{font-family:'JetBrains Mono',monospace;font-size:18px;font-weight:700;}
.vg-comp{font-size:10px;color:var(--muted2);margin-top:2px;}
.vg-bar-row{padding:8px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;}
.vg-bar-track{flex:1;height:6px;background:var(--border2);border-radius:3px;overflow:hidden;display:flex;}
.vg-members{flex:1;}
.vg-members::-webkit-scrollbar{width:3px;}
.vg-members::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.vg-row{display:flex;align-items:center;padding:5px 16px;gap:8px;border-bottom:1px solid rgba(255,255,255,0.03);transition:background .1s;}
.vg-row:last-child{border-bottom:none;}
.vg-row:hover{background:rgba(255,255,255,0.04);}
.vg-row.highlight{background:rgba(255,230,0,0.06);}
.vg-row.dimmed{opacity:.35;}
.vg-num{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--muted);min-width:16px;}
.vg-tag{font-size:8px;font-weight:700;border-radius:2px;padding:1px 4px;}
.vg-tag-F{background:var(--fem-bg);color:var(--fem);}
.vg-tag-M{background:var(--masc-bg);color:var(--masc);}
.vg-name{font-size:11px;flex:1;}
.vg-rota{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--muted);background:var(--mid);border-radius:2px;padding:1px 4px;}
.vg-badge{font-size:8px;padding:1px 5px;border-radius:2px;}
.vg-foot{padding:10px 18px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;background:var(--mid);}
.vg-foot-stat{font-size:10px;color:var(--muted2);}
.vg-foot-stat span{font-weight:700;color:var(--text);}
</style>
</head>
<body>

<!-- ══════════════════════════════════════════
     TELA 1: SELEÇÃO DE MODO
══════════════════════════════════════════ -->
<div class="screen active" id="screen-select" style="align-items:center;justify-content:center;min-height:100vh;">
  <div class="select-wrap">
    <div class="select-logo">SMG1 · T2</div>
    <div class="select-title">Grupos de Trabalho</div>
    <div class="select-sub">Como você quer acessar?</div>
    <div class="mode-cards">
      <div class="mode-card" onclick="goColab()">
        <div class="mc-icon">🔍</div>
        <div class="mc-title">Ver meu grupo</div>
        <div class="mc-desc">Busque seu nome e veja em qual grupo você está e quem são seus colegas.</div>
      </div>
      <div class="mode-card visao-card" onclick="goVisao()">
        <div class="mc-icon">📋</div>
        <div class="mc-title">Visão Geral</div>
        <div class="mc-desc">Veja todos os grupos lado a lado com composição completa de cada um.</div>
      </div>
      <div class="mode-card admin-card" onclick="goLogin()">
        <div class="mc-icon">🔐</div>
        <div class="mc-title">Painel Admin</div>
        <div class="mc-desc">Acesso restrito. Gerencie os grupos, adicione novatos e inative colaboradores.</div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════════
     TELA 2: VISÃO GERAL
══════════════════════════════════════════ -->
<div class="screen" id="screen-visao">
  <div class="colab-topbar" style="border-bottom-color:#4DA6FF;">
    <div class="colab-logo" style="background:#4DA6FF;">SMG1 · T2</div>
    <span class="colab-title">Visão Geral dos Grupos</span>
    <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
      <div id="visao-search-wrap" style="position:relative;">
        <input id="visao-search" type="text" placeholder="🔎 Filtrar nome..." autocomplete="off"
          style="background:var(--card);border:1px solid var(--border2);color:var(--text);border-radius:7px;padding:6px 12px;font-size:12px;font-family:'Inter',sans-serif;outline:none;width:180px;transition:border .15s;"
          oninput="filtrarVisao()" onfocus="this.style.borderColor='#4DA6FF'" onblur="this.style.borderColor='var(--border2)'">
      </div>
      <button class="back-btn" onclick="goSelect()">← Voltar</button>
    </div>
  </div>

  <!-- Stats rápidas -->
  <div style="padding:16px 28px 0;display:flex;gap:10px;flex-wrap:wrap;" id="visao-stats"></div>

  <!-- Grid dos grupos -->
  <div style="padding:16px 28px 28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;" id="visao-grid"></div>
</div>

<!-- ══════════════════════════════════════════
     TELA 3: VISÃO COLABORADOR
══════════════════════════════════════════ -->
<div class="screen" id="screen-colab">
  <div class="colab-topbar">
    <div class="colab-logo">SMG1 · T2</div>
